{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:53225/",
      "sslPort": 44365
    }
  },
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Service.Registry.Host": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:7777"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/api/service/all",
      "environmentVariables": {
        "ServiceRegistry__Host": "http://+:8080"
      },
      "httpPort": 7777
    }
  }
}