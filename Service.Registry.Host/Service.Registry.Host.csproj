<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>Service.Registry.Host.Program</StartupObject>
    <Copyright>Stanislav Batyrgareev</Copyright>
    <Version>6.0.48</Version>
    <PackageProjectUrl>https://bitbucket.org/SBatyrgareev/serviceregistry/src</PackageProjectUrl>
    <RepositoryUrl>https://bitbucket.org/SBatyrgareev/serviceregistry/src</RepositoryUrl>
    <UserSecretsId>d65d2e5d-2a71-48e8-bbfd-ed62d56ba7d8</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- the Dockerfile copies all projects of the solution: build context is the solution folder -->
    <DockerfileContext>..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service.Registry.Impl\Service.Registry.Impl.csproj" />
    <ProjectReference Include="..\Service.Registry\Service.Registry.csproj" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>


</Project>
