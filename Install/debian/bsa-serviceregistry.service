[Unit]
Description=BSA Service Registry (addresses of REST and TCP services)
Documentation=https://bsasearch.org/serviceregistry.html
After=network.target

[Service]
Type=simple
User=bsaserviceregistry
Group=bsaserviceregistry
# the host reads appsettings.json from the working directory
WorkingDirectory=/opt/bsa-serviceregistry
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
# the service keeps its state in memory and writes nothing to disk
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
SyslogIdentifier=bsa-serviceregistry

[Install]
WantedBy=multi-user.target
